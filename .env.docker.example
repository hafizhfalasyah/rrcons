# Docker Compose project identity
COMPOSE_PROJECT_NAME=rrcons

# Host port mappings
RRCONS_APP_PORT=8082
# MariaDB untuk `php artisan serve` native (hanya 127.0.0.1); 3306 biasanya dipakai XAMPP
RRCONS_DB_PORT=3307
RRCONS_MAILPIT_SMTP_PORT=1025
RRCONS_MAILPIT_UI_PORT=8025

# Laravel application runtime (nilai lain seperti APP_TIMEZONE, APP_LOCALE, SEO_*, ANALYTICS_*
# dibaca dari file .env proyek yang ikut ter-mount ke container)
RRCONS_APP_NAME=RRCONS
RRCONS_APP_ENV=local
# Generate with: docker compose --env-file .env.docker run --rm app php artisan key:generate --show
RRCONS_APP_KEY=
RRCONS_APP_DEBUG=true
RRCONS_APP_URL=http://localhost:8082

# Laravel logging
RRCONS_LOG_CHANNEL=stack
RRCONS_LOG_LEVEL=debug

# Local-only database bootstrap and Laravel connection values.
# Replace both example passwords before the database service is started.
RRCONS_DB_DATABASE=rrcons
RRCONS_DB_USERNAME=rrcons
RRCONS_DB_PASSWORD=change-me
RRCONS_DB_ROOT_PASSWORD=change-root-me

# Email lokal ditangkap Mailpit (http://localhost:8025), tidak pernah terkirim keluar
RRCONS_MAIL_FROM_ADDRESS=noreply@rrcons.local
RRCONS_MAIL_FROM_NAME=RRCONS
