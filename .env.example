APP_NAME=RRCONS
APP_ENV=local
APP_KEY=
APP_DEBUG=true
# Lokal native: php artisan serve (http://localhost:8000). Produksi: https://rrconsindonesia.com
APP_URL=http://localhost:8000
APP_TIMEZONE=Asia/Jakarta
APP_LOCALE=en

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Lokal: MariaDB dari docker compose (port 3307, user/password sama dengan .env.docker).
# Di dalam container nilai DB_* ini ditimpa compose.yaml, jadi .env yang sama bisa dipakai keduanya.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3307
DB_DATABASE=rrcons
DB_USERNAME=rrcons
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=public
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
# Lokal: Mailpit dari docker compose (UI http://localhost:8025)
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=mt1

VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

# SEO & GEO (lihat config/seo.php; kosongkan bila belum pasti)
SEO_ORG_SAME_AS=
SEO_GEO_REGION=ID-JI
SEO_GEO_REGION_NAME="Jawa Timur"
SEO_GEO_LOCALITY=Malang
SEO_GEO_POSTAL_CODE=
SEO_GEO_LATITUDE=
SEO_GEO_LONGITUDE=
SEO_GOOGLE_VERIFICATION=
SEO_BING_VERIFICATION=

# Visitor analytics (lihat config/analytics.php)
ANALYTICS_ENABLED=true
ANALYTICS_EXCLUDE_AUTHENTICATED=true
# IP yang tidak dihitung, mis. IP kantor (pisahkan dengan koma)
ANALYTICS_EXCLUDE_IPS=
# Isi "*" bila situs berada di balik Cloudflare/proxy agar IP pengunjung terbaca benar
TRUSTED_PROXIES=
# Mis. CF-IPCountry bila memakai Cloudflare (untuk statistik negara)
ANALYTICS_COUNTRY_HEADER=
ANALYTICS_RETENTION_DAYS=730

# Perkecil ukuran gambar yang diunggah lewat admin (tanpa perubahan visual). Gambar lama:
#   php artisan rrcons:optimize-images --dry-run
OPTIMIZE_UPLOADED_IMAGES=true
